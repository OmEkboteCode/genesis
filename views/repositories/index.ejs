<% layout("/layouts/boilerplate") %>

<main class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">Repositories</h3>
            <p class="text-muted mb-0">
                Browse repositories in Genesis
            </p>
        </div>
<!-- 
        <a href="/repositories/new" class="btn btn-primary">
            New repository
        </a> -->
        <a href="/repositories/recent" class="btn btn-outline-secondary">
            Recently viewed
        </a>

    </div>

    <div class="repository-list">

        <% for(let repository of allRepository) { %>

            <div class="repository-item py-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <h5 class="mb-1">
                            <a
                                href="/repositories/<%= repository._id %>"
                                class="text-decoration-none"
                            >
                                <%= repository.name %>
                            </a>
                        </h5>

                        <p class="repository-owner mb-1">
                            <%= repository.owner.username %>
                        </p>

                        <small class="repository-date">
                            Created <%= repository.createdAt.toLocaleDateString() %>
                        </small>

                    </div>

                    <span class="badge rounded-pill border text-dark">
                        <%= repository.visibility %>
                    </span>

                </div>

            </div>

        <% } %>

    </div>

</main>