<% layout("/layouts/boilerplate") %>

<main class="container py-4">

    <div class="mb-4">
        <h3>All Repositories</h3>
    </div>

    <div class="repository-list">

        <% for(let repository of allRepository) { %>

            <div class="repository-item py-4 border-bottom">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <h5 class="mb-1">
                            <a
                                href="/repositories/<%= repository._id %>"
                                class="text-decoration-none"
                            >
                                <%= repository.name %>
                            </a>
                        </h5>

                        <p class="text-muted mb-2">
                            Owner: <%= repository.owner.username %>
                        </p>

                        <small class="text-muted">
                            Created <%= repository.createdAt.toLocaleDateString() %>
                        </small>
                    </div>

                    <span class="badge rounded-pill border text-dark">
                        <%= repository.visibility %>
                    </span>

                </div>

            </div>

        <% } %>

    </div>

</main>