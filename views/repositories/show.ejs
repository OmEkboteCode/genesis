<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-2">

    <h3 class="mb-4">Repository Details</h3>

    <div class="card show-card">

      <div class="card-body">

        <!-- Repository Name -->
        <h4 class="card-title mb-3">
          <%= repository.name %>
        </h4>

        <!-- Description -->
        <p class="card-text">
          <%= repository.description || "No description provided." %>
        </p>

        <hr>

        <!-- Repository Information -->
        <p class="card-text">
          <strong>Language:</strong>
          <%= repository.language || "Not specified" %>
        </p>

        <p class="card-text">
          <strong>Visibility:</strong>
          <%= repository.visibility %>
        </p>

        <p class="card-text">
          <strong>Owner:</strong>
          <%= repository.owner || "Not specified" %>
        </p>

        <p class="card-text">
          <strong>Created:</strong>
          <%= repository.createdAt.toLocaleString() %>
        </p>

        <!-- Actions -->
        <div class="mt-4">
          <a
            href="/repositories/<%= repository._id %>/edit"
            class="btn btn-success"
          >
            Edit
          </a>
          <form method="POST" action="/repositories/<%= repository._id %>?_method=DELETE">
            <button class="btn btn-success">Delete</button>
          </form>

          <a
            href="/repositories"
            class="btn btn-secondary"
          >
            Back to Repositories
          </a>
        </div>

      </div>

    </div>

  </div>
</div>