<% layout("/layouts/boilerplate") %>

<main class="container py-4">

  <!-- Repository Header -->
  <div class="repo-header pb-3 border-bottom">

    <div class="d-flex justify-content-between align-items-start">

      <div>


        <h2 class="repo-title">
          <%= repository.name %>
        </h2>
        <div class="repo-owner">
          <%= repository.owner.username %>
        </div>

        <p class="repo-description">
          <%= repository.description || "No description provided." %>
        </p>
      </div>

      <span class="badge rounded-pill border text-dark">
        <%= repository.visibility %>
      </span>

    </div>

  </div>


  <!-- Repository Information -->
  <div class="repo-info py-4">

    <div class="row">

      <div class="col-md-8">

        <h5>About this repository</h5>

        <p class="text-muted">
          <%= repository.description || "No description provided." %>
        </p>

      </div>

      <div class="col-md-4">

        <p class="mb-2">
          <strong>Language</strong>
        </p>

        <p class="text-muted">
          <%= repository.language || "Not specified" %>
        </p>

        <p class="mb-2 mt-3">
          <strong>Created</strong>
        </p>

        <p class="text-muted">
          <%= repository.createdAt.toLocaleString() %>
        </p>

      </div>

    </div>

  </div>


  <!-- Actions -->
  <div class="border-top pt-3">

    <a
      href="/repositories/<%= repository._id %>/edit"
      class="btn btn-outline-primary me-2"
    >
      Edit
    </a>

    <form
      method="POST"
      action="/repositories/<%= repository._id %>?_method=DELETE"
      class="d-inline"
    >
      <button class="btn btn-outline-danger">
        Delete
      </button>
    </form>

    <a
      href="/repositories"
      class="btn btn-outline-secondary ms-2"
    >
      Back
    </a>

  </div>

</main>